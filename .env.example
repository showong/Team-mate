# Team-mate Phase 1 environment variables
# Copy this file to `.env` and fill in real values.

# --- LLM provider --------------------------------------------------
# One of: mock, openai, anthropic, gemini, local
LLM_PROVIDER=mock

# Per-role default models (used when provider != mock)
LLM_MODEL_JUNIOR=gpt-4o-mini
LLM_MODEL_DEPUTY=gpt-4o
LLM_MODEL_SUBLEADER=claude-opus-4-7
LLM_MODEL_ROUTER=gpt-4o-mini

# Provider API keys (only fill in what you actually use)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- Storage -------------------------------------------------------
# SQLite by default, e.g. sqlite:///./team_mate.db
DATABASE_URL=sqlite:///./team_mate.db

# --- Workflow defaults --------------------------------------------
DEFAULT_COST_MODE=balanced
DEFAULT_VERIFICATION_LEVEL=standard
DEFAULT_MAX_RETRY=1
DEFAULT_BUDGET_CAP=1500

# --- Server --------------------------------------------------------
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
